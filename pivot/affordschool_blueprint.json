{
  "project": {
    "name": "AffordSchool",
    "working_title": "Affordable Schools Finder",
    "purpose": "Parent-first school matching platform for affordable primary schools in middle-class South African suburbs using simulated data for development and testing.",
    "status": "blueprint_v1",
    "data_policy": {
      "mode": "simulated_only",
      "note": "All entities, fee values, ratings, distances, and reviews are generated for build and test purposes only. No production or live school data should be implied in the MVP."
    }
  },
  "product_strategy": {
    "core_positioning": "Find primary schools near you that fit your budget, commute, and priorities.",
    "target_user": {
      "persona": "Middle-class parent or guardian searching for affordable primary schools",
      "geography": "Middle-class suburbs in South Africa",
      "example_suburbs": [
        "Noordwyk",
        "Halfway Gardens",
        "Vorna Valley",
        "Buccleuch",
        "Randburg clusters"
      ],
      "excluded_focus": [
        "Prestige-first upmarket suburb positioning",
        "Feeder/catchment-zone logic in MVP"
      ]
    },
    "value_props": [
      "Budget-fit school matches instead of generic directories",
      "Shortlists based on budget, commute, and parent preferences",
      "Affordability-first discovery for middle-class suburbs",
      "Side-by-side comparison of fees, distance, and features",
      "Parent-first matching rather than prestige-first browsing",
      "Saved shortlists, notes, and family decision support"
    ],
    "jobs_to_be_done": [
      "Help me find schools I can actually afford near where I live or work",
      "Help me compare a few realistic options quickly",
      "Help me understand tradeoffs like price vs commute vs activities",
      "Help me save, share, and revisit my shortlist"
    ]
  },
  "mvp_scope": {
    "in_scope": [
      "Primary schools only",
      "Parent onboarding wizard",
      "Budget + distance + preferences matching",
      "Searchable school cards and comparison pages",
      "School detail pages",
      "Saved shortlist",
      "Notes per school",
      "Share shortlist link",
      "Simulated reviews and structured review dimensions",
      "SEO landing pages for suburb + budget/use-case"
    ],
    "out_of_scope": [
      "Real payment processing",
      "Real admissions submission",
      "Feeder/catchment calculations",
      "Live maps APIs in first prototype if not needed",
      "Verified reviews system",
      "School owner dashboards",
      "Native mobile app",
      "Production-grade analytics warehouse"
    ]
  },
  "user_experience": {
    "design_principles": [
      "Parent-first, not school-first",
      "Ask for constraints before showing listings",
      "Explain tradeoffs clearly",
      "Bias toward clarity over feature density",
      "Use confidence and verification labels on every uncertain data point",
      "Minimize decision fatigue"
    ],
    "primary_flow": [
      {
        "step": 1,
        "screen": "landing_page",
        "goal": "Explain value proposition and start wizard",
        "cta": "Find schools that fit your budget"
      },
      {
        "step": 2,
        "screen": "onboarding_wizard",
        "goal": "Collect parent constraints",
        "inputs": [
          "child_grade",
          "monthly_budget_or_annual_budget",
          "home_suburb",
          "optional_work_suburb",
          "max_commute_minutes_or_km",
          "must_have_features",
          "nice_to_have_features",
          "school_type_preference"
        ]
      },
      {
        "step": 3,
        "screen": "results_page",
        "goal": "Show ranked shortlist",
        "outputs": [
          "fit_score",
          "estimated_monthly_cost",
          "distance",
          "top_matching_features",
          "tradeoff_warning",
          "save_button",
          "compare_checkbox"
        ]
      },
      {
        "step": 4,
        "screen": "comparison_table",
        "goal": "Help parent compare shortlisted options side by side"
      },
      {
        "step": 5,
        "screen": "school_detail_page",
        "goal": "Answer all key questions about a chosen school"
      },
      {
        "step": 6,
        "screen": "saved_shortlist",
        "goal": "Support return visits and household decision-making"
      }
    ],
    "wizard_questions": [
      {
        "id": "child_grade",
        "type": "single_select",
        "label": "What grade is your child entering?",
        "options": [
          "Grade R",
          "Grade 1",
          "Grade 2",
          "Grade 3",
          "Grade 4",
          "Grade 5",
          "Grade 6",
          "Grade 7"
        ]
      },
      {
        "id": "budget_type",
        "type": "single_select",
        "label": "How do you think about school budget?",
        "options": [
          "Monthly",
          "Annual"
        ]
      },
      {
        "id": "budget_value",
        "type": "range",
        "label": "What is your school fee budget?",
        "validation": {
          "min": 1000,
          "max": 250000,
          "currency": "ZAR"
        }
      },
      {
        "id": "home_suburb",
        "type": "autocomplete",
        "label": "Where do you live?"
      },
      {
        "id": "work_suburb",
        "type": "autocomplete_optional",
        "label": "Where do you work?"
      },
      {
        "id": "max_commute",
        "type": "single_select",
        "label": "How far are you willing to travel?",
        "options": [
          "Under 3 km",
          "Under 5 km",
          "Under 8 km",
          "Under 12 km",
          "Best options within 20 min"
        ]
      },
      {
        "id": "must_have_features",
        "type": "multi_select",
        "label": "What must the school have?",
        "options": [
          "Aftercare",
          "Transport",
          "Swimming",
          "Soccer",
          "Rugby",
          "Cricket",
          "Netball",
          "Music",
          "Coding/Robotics",
          "Religious alignment",
          "Small classes"
        ]
      },
      {
        "id": "nice_to_have_features",
        "type": "multi_select",
        "label": "Anything nice to have?",
        "options": [
          "Library",
          "Extra murals",
          "Modern classrooms",
          "Meal option",
          "Holiday care",
          "Sibling discount"
        ]
      },
      {
        "id": "school_type",
        "type": "single_select",
        "label": "What type of school are you open to?",
        "options": [
          "Private only",
          "Public only",
          "Both"
        ]
      }
    ]
  },
  "ranking_and_matching": {
    "overview": "Every school gets a parent-specific fit score from 0 to 100.",
    "formula": {
      "fit_score": "budget_fit*0.35 + distance_fit*0.25 + must_have_fit*0.20 + nice_to_have_fit*0.08 + school_type_fit*0.05 + rating_fit*0.07"
    },
    "components": {
      "budget_fit": {
        "logic": [
          "100 if estimated annual cost <= parent budget",
          "70 if within 10 percent above budget",
          "40 if within 25 percent above budget",
          "0 if more than 25 percent above budget"
        ]
      },
      "distance_fit": {
        "logic": [
          "100 if within preferred commute threshold",
          "Score decays linearly as distance exceeds threshold"
        ]
      },
      "must_have_fit": {
        "logic": "Required features missing trigger major penalties"
      },
      "nice_to_have_fit": {
        "logic": "Soft preference bonus"
      },
      "school_type_fit": {
        "logic": "Bonus when the school's type matches the user's selected openness"
      },
      "rating_fit": {
        "logic": "Use simulated parent review score only as a small weight"
      }
    },
    "tradeoff_labels": [
      "Best budget fit",
      "Closest match",
      "Best sports match",
      "Best all-round value",
      "Above budget but strong feature fit",
      "Affordable but fewer extras"
    ]
  },
  "page_architecture": {
    "core_routes": [
      {
        "route": "/",
        "type": "landing"
      },
      {
        "route": "/match",
        "type": "wizard"
      },
      {
        "route": "/results",
        "type": "dynamic_results"
      },
      {
        "route": "/compare",
        "type": "comparison"
      },
      {
        "route": "/schools/[slug]",
        "type": "school_detail"
      },
      {
        "route": "/shortlist",
        "type": "saved_shortlist"
      },
      {
        "route": "/suburbs/[suburb]",
        "type": "suburb_hub"
      },
      {
        "route": "/suburbs/[suburb]/affordable-primary-schools",
        "type": "seo_landing"
      },
      {
        "route": "/suburbs/[suburb]/schools-under-[budget-band]",
        "type": "seo_landing"
      },
      {
        "route": "/suburbs/[suburb]/schools-with-[feature]",
        "type": "seo_landing"
      },
      {
        "route": "/schools/[slug]/reviews",
        "type": "review_subpage"
      }
    ],
    "seo_templates": [
      "Affordable primary schools in [suburb]",
      "Primary schools in [suburb] under [budget_band]",
      "Schools with aftercare in [suburb]",
      "Schools with swimming in [suburb]",
      "Affordable private schools near [suburb]",
      "Compare primary schools in [suburb]",
      "[School Name] fees and reviews"
    ],
    "indexing_policy": {
      "index": [
        "suburb hubs with enough school density",
        "budget-band pages with meaningful results",
        "feature pages with at least 5 relevant schools",
        "school detail pages"
      ],
      "noindex": [
        "empty result states",
        "thin combinations with too few schools",
        "internal result URLs with arbitrary query spam"
      ]
    }
  },
