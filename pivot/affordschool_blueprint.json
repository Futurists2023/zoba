  "simulated_data_strategy": {
    "requirements": [
      "Generate at least 10 target suburbs",
      "Generate 15 to 30 schools per suburb",
      "Ensure realistic fee dispersion across public, low-fee private, and premium outliers",
      "Generate distances from suburb centers",
      "Generate activities and facilities with weighted probabilities",
      "Generate 3 to 20 simulated reviews per school",
      "Mark every simulated record explicitly"
    ],
    "distribution_rules": {
      "school_types": {
        "public": 0.35,
        "private_low_fee": 0.35,
        "private_mid_tier": 0.2,
        "private_premium": 0.1
      },
      "fee_bands_zar_annual": {
        "public": [
          12000,
          30000
        ],
        "private_low_fee": [
          25000,
          70000
        ],
        "private_mid_tier": [
          70000,
          140000
        ],
        "private_premium": [
          140000,
          220000
        ]
      }
    }
  },
