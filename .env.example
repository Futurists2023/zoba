# Local development can run on seeded in-memory data without a database.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: connect to the dedicated AffordableSchools Supabase/Postgres project.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
